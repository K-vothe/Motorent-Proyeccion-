generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  RENTER
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RenterVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OwnerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MotoStatus {
  PENDING_APPROVAL
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
  REJECTED
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HandoverType {
  PICKUP
  RETURN
}

enum ReviewTargetType {
  MOTO
  OWNER
  RENTER
}

// ----------------------------------------------------
// USER AND PROFILE MODELS
// ----------------------------------------------------

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String
  phone     String
  role      Role     @default(USER)

  // Email verification
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // Password recovery
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?

  // Profiles
  owner     Owner?
  renter    Renter?

  // Reviews (Fase 6)
  reviewsWritten  Review[] @relation("ReviewsWritten")
  reviewsReceived Review[] @relation("ReviewsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// RENTER
// ----------------------------------------------------

model Renter {
  id                 String   @id @default(uuid())
  idUser             String   @unique

  // Personal identification
  cedulaNumero       String   @unique
  cedulaFrontUrl     String
  cedulaBackUrl      String
  photo              String

  // Driving license
  licenseNumber      String   @unique
  licenseFrontUrl    String
  licenseBackUrl     String
  licenseCategory    String

  // Proof of address
  billUrl            String

  // Verification
  estadoVerificacion RenterVerificationStatus @default(PENDING)
  motivoRechazo      String?
  fechaVerificacion  DateTime?

  // Dates
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user               User     @relation(fields: [idUser], references: [id])

  rentals       Rental[]
}

// ----------------------------------------------------
// OWNER
// ----------------------------------------------------

model Owner {
  id                 String   @id @default(uuid())
  idUser             String   @unique

  // Personal identification
  cedulaNumero       String   @unique
  cedulaFrontUrl     String
  cedulaBackUrl      String
  photo              String
  billUrl            String

  // Verification
  estadoVerificacion OwnerVerificationStatus @default(PENDING)
  motivoRechazo      String?
  fechaVerificacion  DateTime?

  // Dates
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user               User     @relation(fields: [idUser], references: [id])
  motos              Moto[]
}

// ----------------------------------------------------
// VEHICLE MODELS
// ----------------------------------------------------

model Moto {
  id            String      @id @default(uuid())

  // If ownerId is null -> MotoRent company motorcycle
  // If ownerId has a value -> Private owner's motorcycle
  ownerId       String?
  owner         Owner?      @relation(fields: [ownerId], references: [id])

  brand         String
  model         String
  year          Int
  licensePlate  String      @unique
  displacement  String
  KM            Int
  color         String
  dailyRate     Decimal     @db.Decimal(10, 2)
  status        MotoStatus  @default(AVAILABLE)

  document      MotoDocument?
  rentals       Rental[]
  reviews       Review[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ----------------------------------------------------
// MOTO DOCUMENT
// ----------------------------------------------------

model MotoDocument {
  id                   String             @id @default(uuid())
  motoId               String             @unique
  transitLicenseNumber String             @unique
  transitLicenseImage  String
  verificationStatus   VerificationStatus @default(PENDING)
  verifiedAt           DateTime?

  moto       Moto     @relation(fields: [motoId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ----------------------------------------------------
// RENTAL, CONTRACT AND HANDOVER MODELS
// ----------------------------------------------------

model Rental {
  id            String       @id @default(uuid())
  renterId      String
  motoId        String
  startDate     DateTime
  endDate       DateTime

  // Payment breakdown and commissions
  subtotal      Decimal
  platformFee   Decimal      @default(0)
  ownerEarnings Decimal      @default(0)
  total         Decimal

  status        RentalStatus @default(PENDING)

  renter        Renter      @relation(fields: [renterId], references: [id])
  moto          Moto         @relation(fields: [motoId], references: [id])

  contract      Contract?
  handovers     VehicleHandover[]
  reviews       Review[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

}

model Contract {
  id             String         @id @default(uuid())
  rentalId       String         @unique
  contractNumber String         @unique
  status         ContractStatus @default(ACTIVE)
  accepted       Boolean        @default(false)
  acceptedAt     DateTime?
  observations   String?

  rental     Rental   @relation(fields: [rentalId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VehicleHandover {
  id           String             @id @default(uuid())
  rentalId     String
  type         HandoverType
  mileage      Int
  fuelLevel    Decimal
  observations String?

  rental      Rental             @relation(fields: [rentalId], references: [id])
  evidences   HandoverEvidence[]

  createdAt   DateTime           @default(now())
}

model HandoverEvidence {
  id          String          @id @default(uuid())
  handoverId  String

  fileUrl     String
  description String?

  handover    VehicleHandover @relation(fields: [handoverId], references: [id])

  createdAt   DateTime        @default(now())
}

// ----------------------------------------------------
// REVIEWS & PUBLIC REPUTATION (FASE 6)
// ----------------------------------------------------

model Review {
  id           String           @id @default(uuid())
  rentalId     String
  authorId     String
  targetUserId String
  motoId       String?
  targetType   ReviewTargetType
  rating       Int
  comment      String?
  visibleAt    DateTime

  rental     Rental @relation(fields: [rentalId], references: [id])
  author     User   @relation("ReviewsWritten", fields: [authorId], references: [id])
  targetUser User   @relation("ReviewsReceived", fields: [targetUserId], references: [id])
  moto       Moto?  @relation(fields: [motoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([rentalId, authorId, targetType])
}